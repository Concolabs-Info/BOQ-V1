# Quanto local development settings

# PostgreSQL
# For the Windows setup used in this project, the default admin user is postgres.
POSTGRES_DB=quanto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/quanto

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=500
RENDER_THUMBNAIL_DPI=72
RENDER_WORKING_DPI=150

# Controlled AI provider
# local  = real PDF/storage/database + manual review; no external AI call.
# openai = Pre vision + production Floor/Ceiling/Roof detection from real drawings.
# gemini remains supported by the existing Pre pipeline.
AI_PROVIDER=local

OPENAI_API_KEY=
# Medium/default Floor + Ceiling + Roof quality. Server-side quality mapping can use
# gpt-5.6-luna (Easy), gpt-5.6-terra (Medium), gpt-5.6-sol (Expert/Maximum).
OPENAI_MODEL=gpt-5.6-terra

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

MODEL_RETRIES=2
MODEL_CONCURRENCY=4

# Browser
NEXT_PUBLIC_API_URL=http://localhost:8000
