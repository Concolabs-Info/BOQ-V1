# Quanto local development settings

# PostgreSQL
POSTGRES_DB=quanto
POSTGRES_USER=quanto
POSTGRES_PASSWORD=quanto
DATABASE_URL=postgresql://quanto:quanto@localhost:5432/quanto

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=500
RENDER_THUMBNAIL_DPI=72
RENDER_WORKING_DPI=150

# Controlled Pre extraction provider
# local: PDF text evidence plus manual review/calibration; no external model call
# gemini: planned schema-constrained visual extraction for the production Pre pipeline
# openai: schema-constrained visual extraction for triage, scale/height and specifications
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_RETRIES=2
MODEL_CONCURRENCY=4

# Browser
NEXT_PUBLIC_API_URL=http://localhost:8000
