DATABASE_URL=postgresql://quanto:quanto@localhost:5432/quanto
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=500
RENDER_THUMBNAIL_DPI=72
RENDER_WORKING_DPI=150

# local = PDF text-layer proposals + complete manual review/calibration flow.
# gemini = planned schema-constrained vision provider for production Pre.
# openai = schema-constrained vision for the three model-call types in the Pre plan.
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
# Set this to a vision-capable structured-output model available in your account.
OPENAI_MODEL=
MODEL_RETRIES=2
MODEL_CONCURRENCY=4
