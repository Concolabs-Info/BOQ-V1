# Backend-only override. Normally copy the root .env.example to ../.env instead;
# the backend loads the root .env first and this file second when present.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/quanto
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=500
RENDER_THUMBNAIL_DPI=72
RENDER_WORKING_DPI=150

PRE_AI_PROVIDER=gemini
TAKEOFF_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MODEL_RETRIES=2
MODEL_CONCURRENCY=4
