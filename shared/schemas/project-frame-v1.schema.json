{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanto.local/schemas/project-frame-v1.schema.json",
  "title": "Quanto Project Frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "frame_version",
    "created_at",
    "coordinate_contract",
    "source_documents",
    "sheets",
    "viewports",
    "levels",
    "spec_items",
    "transforms"
  ],
  "properties": {
    "schema_version": { "const": "project-frame-v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": ["string", "null"] }
      }
    },
    "frame_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "coordinate_contract": { "type": "object" },
    "source_documents": { "type": "array", "items": { "type": "object" } },
    "sheets": { "type": "array", "items": { "type": "object" } },
    "viewports": { "type": "array", "items": { "type": "object" } },
    "levels": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "spec_items": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "transforms": { "type": "array", "items": { "type": "object" } }
  }
}
